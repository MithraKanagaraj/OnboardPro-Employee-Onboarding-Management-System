@model Document
@{ ViewData["Title"] = "Delete document"; }
<h1 class="h2">Delete document</h1><p>Delete <strong>@Model.DocumentType</strong> (@Model.OriginalFileName) for @Model.Employee.FullName?</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button class="btn btn-danger" type="submit">Delete document</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
