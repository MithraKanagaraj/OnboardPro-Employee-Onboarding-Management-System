@model IReadOnlyList<Document>
@{ ViewData["Title"] = User.IsInRole(AppRoles.Hr) ? "Documents" : "My documents"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h2 mb-1">@ViewData["Title"]</h1><p class="text-secondary mb-0">Securely submit documents and follow review status.</p></div>@if (User.IsInRole(AppRoles.NewJoiner)) { <a class="btn btn-primary" asp-action="Upload">Upload document</a> }</div>
<div class="card">
@if (Model.Count == 0) { <div class="card-body text-center py-5"><h2 class="h5">No documents yet</h2><p class="text-secondary mb-0">Uploaded documents and review decisions will appear here.</p></div> }
else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr>@if (User.IsInRole(AppRoles.Hr)) { <th>Employee</th> }<th>Document</th><th>Uploaded</th><th>Status</th><th>Review note</th><th></th></tr></thead><tbody>
@foreach (var document in Model) { <tr>
@if (User.IsInRole(AppRoles.Hr)) { <td>@document.Employee?.FullName</td> }
<td><strong>@document.DocumentType</strong><div class="small text-secondary">@document.OriginalFileName</div></td><td>@document.UploadedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
<td><span class="badge @(document.Status == DocumentStatus.Approved ? "text-bg-success" : document.Status == DocumentStatus.Rejected ? "text-bg-danger" : "text-bg-warning")">@document.Status</span></td><td>@document.ReviewNote</td>
<td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@document.Id">Details</a> · <a asp-action="Download" asp-route-id="@document.Id">Download</a>
@if (User.IsInRole(AppRoles.Hr)) { <text> · </text><a asp-action="Review" asp-route-id="@document.Id">Review</a><text> · </text><a asp-action="Delete" asp-route-id="@document.Id" class="text-danger">Delete</a> }
</td></tr> }
</tbody></table></div> }
</div>
