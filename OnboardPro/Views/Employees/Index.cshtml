@model IReadOnlyList<Employee>
@{
    ViewData["Title"] = "Employees";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h2 mb-1">Employees</h1><p class="text-secondary mb-0">Manage new joiners and their access roles.</p></div>
    <a class="btn btn-primary" asp-action="Create">Add employee</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-5"><input class="form-control" name="search" value="@ViewData["Search"]" placeholder="Search name, email, or department" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Search</button></div>
    <div class="col-auto"><a class="btn btn-outline-secondary" asp-action="Index">Clear</a></div>
</form>
<div class="card">
    @if (Model.Count == 0)
    {
        <div class="card-body text-center py-5"><h2 class="h5">No employees found</h2><p class="text-secondary mb-0">Add an employee or change the search.</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead><tr><th>Name</th><th>Email</th><th>Job title</th><th>Access role</th><th>Start date</th><th></th></tr></thead>
            <tbody>@foreach (var employee in Model)
            {
                <tr>
                    <td class="fw-semibold">@employee.FullName</td><td>@employee.Email</td><td>@employee.JobTitle</td>
                    <td><span class="badge text-bg-light">@employee.Role.Name</span></td><td>@employee.StartDate.ToString("MMM d, yyyy")</td>
                    <td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@employee.Id">Details</a> · <a asp-action="Edit" asp-route-id="@employee.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@employee.Id" class="text-danger">Delete</a></td>
                </tr>
            }</tbody>
        </table></div>
    }
</div>
