@model OnboardingTask
@{ ViewData["Title"] = "Task details"; }
<h1 class="h2">Task details</h1><div class="card"><dl class="row card-body mb-0"><dt class="col-sm-3">Employee</dt><dd class="col-sm-9">@Model.Employee.FullName</dd><dt class="col-sm-3">Task</dt><dd class="col-sm-9">@Model.TitleSnapshot</dd><dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.DescriptionSnapshot</dd><dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.CategorySnapshot</dd><dt class="col-sm-3">Due date</dt><dd class="col-sm-9">@Model.DueDate</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd></dl></div>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary mt-3">Edit</a> <a asp-action="Index" class="btn btn-outline-secondary mt-3">Back</a>
