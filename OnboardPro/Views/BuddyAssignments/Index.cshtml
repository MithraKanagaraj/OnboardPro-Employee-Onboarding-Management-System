@model IReadOnlyList<BuddyAssignment>
@{ ViewData["Title"] = User.IsInRole(AppRoles.Hr) ? "Buddy assignments" : "My assigned joiners"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h2 mb-1">@ViewData["Title"]</h1><p class="text-secondary mb-0">Pair new joiners with experienced colleagues.</p></div>@if (User.IsInRole(AppRoles.Hr)) { <a class="btn btn-primary" asp-action="Create">Assign buddy</a> }</div>
<div class="card">
@if (Model.Count == 0) { <div class="card-body text-center py-5"><h2 class="h5">No buddy assignments</h2><p class="text-secondary mb-0">New joiner and buddy pairings will appear here.</p></div> }
else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>New joiner</th><th>Buddy</th><th>Assigned</th><th>Status</th><th>Joiner progress</th><th></th></tr></thead><tbody>
@foreach (var assignment in Model) { var total = assignment.Employee.OnboardingTasks.Count; var complete = assignment.Employee.OnboardingTasks.Count(task => task.Status == OnboardingTaskStatus.Completed); var percent = total == 0 ? 0 : (int)Math.Round(complete * 100d / total); <tr><td>@assignment.Employee.FullName<div class="small text-secondary">@assignment.Employee.JobTitle</div></td><td>@assignment.BuddyEmployee.FullName</td><td>@assignment.AssignedOn.ToString("MMM d, yyyy")</td><td>@(assignment.EndedOn is null ? "Active" : "Ended")</td><td><div class="progress" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width: @percent%"></div></div><small>@complete / @total tasks complete</small></td><td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@assignment.Id">Details</a>@if (User.IsInRole(AppRoles.Hr)) { <text> · </text><a asp-action="Edit" asp-route-id="@assignment.Id">Edit</a><text> · </text><a asp-action="Delete" asp-route-id="@assignment.Id" class="text-danger">Delete</a> }</td></tr> }
</tbody></table></div> }
</div>
